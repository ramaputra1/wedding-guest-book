# Copy to .dev.vars for local Pages Function development (`npm run preview`).
# .dev.vars is git-ignored. Never commit real values.
# Production values are set in the Cloudflare dashboard — docs/SETUP-CLOUDFLARE.md §6.

# Output of `node scripts/hash-passphrase.mjs "<passphrase>"` (script arrives in Phase 3)
WRITER_PASSPHRASE_HASH=

# Output of `openssl rand -base64 32`
SESSION_SIGNING_KEY=

SESSION_TTL_DAYS=180
MAX_VIDEO_DURATION_MS=15000
MAX_VIDEO_BYTES=15000000
MAX_PHOTO_BYTES=8000000

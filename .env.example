# Copy to .dev.vars for signing in under `npm run preview`. .dev.vars is git-ignored.
# Use LOCAL-ONLY values here — never the production key or hash.
# (`npm test` does not need this file: it generates its own throwaway secrets.)
# Plain settings (SESSION_TTL_DAYS, MAX_*) come from wrangler.toml [vars].

# Output of `node scripts/hash-passphrase.mjs` for a throwaway local passphrase
WRITER_PASSPHRASE_HASH=

# Output of `openssl rand -base64 32` — a local key, not the production one
SESSION_SIGNING_KEY=

# Cloudflare Pages response headers. https://developers.cloudflare.com/pages/configuration/headers/

# Build output with a content hash in the filename: safe to cache forever,
# because any change produces a new filename.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Font files are never edited in place. Replacing a font means a new filename.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

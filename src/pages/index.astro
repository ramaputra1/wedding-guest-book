---
// The public landing page: the cover, then the album, read-only.
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CoverLift from '../components/CoverLift.astro';
import GuestBook from '../islands/GuestBook';
import { site } from '../config/site';
---

<Base>
  <CoverLift slot="head" />
  <Hero />
  <main class="album" id="album" data-lift-target>
    {/* client:visible: the cover loads with no island JavaScript; the album
        hydrates and fetches /api/entries only once scrolled into view. */}
    <GuestBook client:visible mode="view" maxPerSpread={site.capture.maxPerSpread} intro={site.intro} copy={site.album} />
  </main>
</Base>

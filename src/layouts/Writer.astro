---
// The writer surface for one of the two iPads. The route is identity, not
// authorization: it says which device is writing. Whether a write is allowed
// is decided by the signed session cookie, checked server-side on every write.
import Base from './Base.astro';
import GuestBook from '../islands/GuestBook';
import { site } from '../config/site';
import type { DeviceId } from '../lib/types';

interface Props {
  deviceId: DeviceId;
}

const { deviceId } = Astro.props;
---

<Base title={`${site.title} · ${site.devices[deviceId]}`}>
  <main class="writer-page">
    <GuestBook
      client:load
      mode="write"
      deviceId={deviceId}
      deviceLabel={site.devices[deviceId]}
      facing={site.capture.facing}
      photoTimers={site.capture.photoTimers}
      maxPerSpread={site.capture.maxPerSpread}
      intro={site.intro}
      copy={site.album}
    />
  </main>
</Base>

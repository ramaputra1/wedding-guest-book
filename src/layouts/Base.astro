---
// The document shell every page shares. Static — nothing here hydrates.
// Stylesheet order matters: tokens → base → components.
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import { site } from '../config/site';

interface Props {
  title?: string;
}

const { title = site.title } = Astro.props;

// The two faces the cover needs at first paint are preloaded: fetching them
// alongside the stylesheet, rather than after it, keeps the names from
// visibly swapping font after the photograph appears.
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#12151C" />{/* --leaf; meta tags cannot read CSS */}
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/spectral-latin-400-italic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/spectral-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    {/* The album's look as this device last saw it (src/lib/look.ts), on
        <html> before first paint, so a returning visitor never sees the
        default colours flash. A few lines, not an island; the island
        fetches the current look and corrects it if it has changed. */}
    <script is:inline>
      try {
        var look = JSON.parse(localStorage.getItem('guestbook-look') || 'null');
        var allowed = /^[a-z-]{1,20}$/;
        if (look) ['leaf', 'frame', 'paper', 'theme'].forEach(function (key) {
          if (allowed.test(look[key])) document.documentElement.dataset[key] = look[key];
        });
      } catch (e) {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

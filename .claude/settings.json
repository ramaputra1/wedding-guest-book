{
  "permissions": {
    "deny": [
      "Read(**/.dev.vars)",
      "Read(**/.dev.vars.*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.preview)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(~/.wrangler/**)",
      "Read(~/Library/Preferences/.wrangler/config/**)",
      "Read(~/.config/.wrangler/config/**)"
    ]
  }
}
